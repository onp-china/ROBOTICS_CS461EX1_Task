.conda-ms3/
.cursor/
/robot311/
__pycache__/
*.pyc
.DS_Store

# Local datasets, generated outputs, and vendored repos.
/data/
/results/
/diffusion_policy/

# Keep placeholder files when these directories are used locally.
/mydiffusion/data/*
!/mydiffusion/data/.gitkeep
/mydiffusion/outputs/*
!/mydiffusion/outputs/.gitkeep
/mydiffusion/reports/*
!/mydiffusion/reports/.gitkeep
/mydiffusion/wandb/*
!/mydiffusion/wandb/.gitkeep

# Ignore accidental duplicate ignore file created locally.
/.gitignore 2
